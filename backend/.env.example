# Skopiuj do .env i uzupelnij. Nie commituj .env.

# development | production | testing
APP_ENV=development
# Wygeneruj: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# 1 na produkcji (HTTPS)
JWT_COOKIE_SECURE=0

CORS_ORIGINS=http://localhost:5173

# Domyslnie SQLite w instance/smartfridge.db; produkcja: postgresql://...
DATABASE_URL=
DATABASE_FILE=smartfridge.db

MQTT_BROKER=
MQTT_PORT=8883
MQTT_LOGIN=
MQTT_PASS=
MQTT_TLS=1
# Inny dla kazdej dzialajacej instancji backendu
MQTT_CLIENT_ID=sf-backend

# Web Push - klucze: python utils/keys_generator.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
